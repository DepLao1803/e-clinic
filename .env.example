# ---------- Infra (docker-compose) ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=e_clinic_db
MYSQL_USER=root
MYSQL_PASSWORD=
# Host port. 3307 avoids clashing with WampServer/any local MySQL on 3306.
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379

# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=4000
DATABASE_URL="mysql://eclinic:eclinic@localhost:3307/e_clinic_db"
REDIS_URL="redis://localhost:6379"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
APP_TZ=Asia/Ho_Chi_Minh
UPLOAD_DIR=./uploads
REMINDER_CRON="0 7 * * *"

# Mailpit (SMTP sink for password-reset & reminder mail): UI at http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="e-Clinic <no-reply@eclinic.local>"
FRONTEND_URL=http://localhost:3000

# Seed
SEED_ADMIN_EMAIL=admin@eclinic.local
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
ENCRYPTION_KEY=change-me-too-(used-to-encrypt-2FA-secrets)
